[Unit]
Description=TRIK WiFi init
After=network.target
Before=trikGui.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for i in $(seq 30); do [ -S /var/run/wpa_supplicant/wlan0 ] && exit 0; [ -f /run/hostapd.pid ] && exit 0; sleep 1; done; exit 0'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
